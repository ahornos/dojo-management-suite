{
  "name": "dojo-management-suite",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "clean:packages": "pnpm --recursive --filter \"./packages/**\" --if-present run clean",
    "build:packages": "pnpm --recursive --filter \"./packages/**\" --if-present run build",
    "build:shared": "pnpm --filter @dms/shared-types build && pnpm --filter @dms/shared-auth build",
    "build:auth": "pnpm --filter auth-service build",
    "clean": "pnpm run clean:packages",
    "build": "pnpm run build:packages",
    "test": "pnpm run test:unit",
    "test:unit": "pnpm --filter @dms/shared-auth --filter auth-service --filter academic-service --filter financial-service --filter api-gateway test",
    "test:e2e": "pnpm --filter auth-service --filter academic-service --filter financial-service --filter api-gateway test:e2e",
    "bootstrap": "bash scripts/bootstrap.sh"
  },
  "devDependencies": {
    "turbo": "^2.11.3"
  },
  "packageManager": "pnpm@12.6.0",
  "type": "module",
  "dependencies": {
    "@radix-ui/react-switch": "^1.3.8"
  }
}
