/// ---------------------------------------------------------
/// Prisma Client Generator & Datasource
/// ---------------------------------------------------------
generator client {
  provider      = "prisma-client-js"
  output        = "../client"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// ---------------------------------------------------------
/// Enums
/// ---------------------------------------------------------
enum Role {
  SUPER_ADMIN
  ADMIN_STAFF
  SPORTS_TECHNICAL_DIRECTOR
  INSTRUCTOR
  STUDENT
  PARENT
  TRIAL
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Lifecycle status of a student within the academy
enum StudentStatus {
  TRIAL
  ACTIVE
  PAUSED
  DROPPED
}

enum DiscountType {
  PERCENTAGE
  FIXED_DISCOUNT
  FREE_PERIOD
}

enum DiscountCategory {
  FAMILY
  SECURITY_FORCES
  TEMPORARY
}

enum CashSessionStatus {
  OPEN
  CLOSED
  RECONCILED
}

enum CashMovementType {
  INCOME
  EXPENSE
}

enum CashCategory {
  MEMBERSHIP_PAYMENT
  EXAM_FEE
  MERCHANDISE_SALE
  OTHER_INCOME
  OPERATIONAL_EXPENSE
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
}

enum RemittanceStatus {
  DRAFT
  GENERATED
  SUBMITTED
  SETTLED
  REJECTED
}

enum RemittanceItemStatus {
  PENDING
  SETTLED
  RETURNED
}

/// Competition / statistics identity. Optional so legacy Excel rows can be imported without it.
enum Gender {
  MALE
  FEMALE
  NON_BINARY
  OTHER
}

/// Structured cause when a student is PAUSED or DROPPED (Excel leave-reason columns).
enum LeaveReason {
  ECONOMIC
  TIME_CONFLICT
  INJURY
  MOVED
  DISSATISFIED
  OTHER
}

/// Channel through which staff learned of a pause or drop.
enum LeaveNoticeMethod {
  PHONE
  WHATSAPP
  IN_PERSON
  RECEPTION
  OTHER
}

/// Who a federation affiliation license (or seasonal charge) belongs to.
enum LicenseHolderType {
  STUDENT
  INSTRUCTOR
  TECHNICAL_DIRECTOR
  /// Club-level federation fee (one charge per academy per season, not a person).
  CLUB
}

/// Collection state of an affiliation license (academic-service).
enum AffiliationLicenseStatus {
  PENDING
  PAID
  EXEMPT
  FAILED
}

/// Contact medium for a tagged federation contact (financial-service).
enum FederationContactMedium {
  EMAIL
  PHONE
  ADDRESS
}

/// One row in a season license-type pricing matrix.
enum LicensePriceRowKind {
  INSTRUCTOR
  ADULT
  CUSTOM
}

/// ---------------------------------------------------------
/// Core Identity & Users
/// ---------------------------------------------------------
/// Login identity owned by auth-service. Demographics (dni, birthDate, phone, address)
/// live exclusively on StudentProfile — never on User.
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  /// Optional; used for competition categories and academy stats. Null on historical imports.
  gender       Gender?
  isActive     Boolean  @default(true)
  roles        Role[]   @default([STUDENT])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model StudentProfile {
  id     String  @id @default(uuid())
  /// Login identity in auth-service. Null for minors (they have no User; parents link via StudentGuardian).
  userId String? @unique

  /// Academic identity of the person-as-student. Adults may also have a User; minors only have these fields.
  firstName  String    @default("")
  lastName   String    @default("")
  dni        String?
  birthDate  DateTime?
  phone      String?
  address    String?
  city       String?
  state      String?
  postalCode String?
  country    String?   @default("ES")
  gender     Gender?

  /// Logical financial-service mandate that covers this student's fees (no physical FK).
  bankMandateId String?

  /// Student Lifecycle Management
  status StudentStatus @default(ACTIVE)

  /// Array of lightweight JSON objects: { name, phone, relationship, customRelationship }
  emergencyContacts Json? @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statusHistory      StudentStatusHistory[]
  guardians          StudentGuardian[]
  ranks              StudentRank[]
  attendances        Attendance[]
  updateRequests     ProfileUpdateRequest[]
  graduationRequests GraduationRequest[]

  @@index([bankMandateId])
  @@map("student_profiles")
}

/// ---------------------------------------------------------
/// Student Lifecycle Audit Log
/// ---------------------------------------------------------
model StudentStatusHistory {
  id                  String             @id @default(uuid())
  studentProfileId    String
  previousStatus      StudentStatus?
  newStatus           StudentStatus
  /// Legacy free-text note. Prefer `leaveReason` / `customReasonDetails` for PAUSED and DROPPED.
  reason              String?            @db.Text
  leaveReason         LeaveReason?
  leaveNoticeMethod   LeaveNoticeMethod?
  /// Free-text complement when `leaveReason` is OTHER (or extra context for any reason).
  customReasonDetails String?            @db.Text
  /// Logical reference to the actor in auth-service (no physical FK).
  changedById         String?
  createdAt           DateTime           @default(now())

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@map("student_status_history")
}

model Guardian {
  id        String   @id @default(uuid())
  /// Logical reference to the identity owned by auth-service (no physical FK; resolve over HTTP)
  userId    String   @unique
  createdAt DateTime @default(now())

  students StudentGuardian[]

  @@map("guardians")
}

model StudentGuardian {
  studentProfileId String
  guardianId       String
  relationship     String?

  student  StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  guardian Guardian       @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@id([studentProfileId, guardianId])
  @@map("student_guardians")
}

/// ---------------------------------------------------------
/// Academy Configuration (Disciplines & Ranks)
/// ---------------------------------------------------------
model Discipline {
  id          String  @id @default(uuid())
  name        String  @unique
  /// Short staff-facing label shown in dense tables (e.g. BJJ). Null falls back to `name`.
  acronym     String?
  description String?

  programs DisciplineProgram[]

  @@map("disciplines")
}

model DisciplineProgram {
  id           String @id @default(uuid())
  disciplineId String
  name         String
  minAge       Int    @default(0)
  maxAge       Int    @default(99)

  discipline Discipline @relation(fields: [disciplineId], references: [id], onDelete: Cascade)
  beltRanks  BeltRank[]

  @@map("discipline_programs")
}

model BeltRank {
  id                  String @id @default(uuid())
  disciplineProgramId String
  name                String
  order               Int
  maxStripes          Int    @default(4)
  minMonthsRequired   Int    @default(0)
  minHoursRequired    Int    @default(0)

  program      DisciplineProgram @relation(fields: [disciplineProgramId], references: [id], onDelete: Cascade)
  studentRanks StudentRank[]

  @@map("belt_ranks")
}

/// ---------------------------------------------------------
/// Academic Records (Ranks & Attendances)
/// ---------------------------------------------------------
model StudentRank {
  id               String   @id @default(uuid())
  studentProfileId String
  beltRankId       String
  currentStripes   Int      @default(0)
  accumulatedHours Int      @default(0)
  promotedAt       DateTime @default(now())
  lastStripeAt     DateTime @default(now())

  student  StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  beltRank BeltRank       @relation(fields: [beltRankId], references: [id])

  @@map("student_ranks")
}

model Attendance {
  id               String   @id @default(uuid())
  studentProfileId String
  date             DateTime @default(now())
  countedForRank   Boolean  @default(true)

  student StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@map("attendances")
}

/// ---------------------------------------------------------
/// Approval Workflows (IAM & Validation)
/// ---------------------------------------------------------
model ProfileUpdateRequest {
  id               String        @id @default(uuid())
  studentProfileId String
  requestedChanges Json
  status           RequestStatus @default(PENDING)
  /// Logical reference to the reviewer in auth-service (no physical FK).
  reviewedById     String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@map("profile_update_requests")
}

model GraduationRequest {
  id               String        @id @default(uuid())
  studentProfileId String
  proposedBeltId   String?
  proposedStripes  Int?
  /// Logical references to identities in auth-service (no physical FK).
  proposedById     String
  approvedById     String?
  status           RequestStatus @default(PENDING)
  createdAt        DateTime      @default(now())

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@map("graduation_requests")
}

/// ---------------------------------------------------------
/// Billing, Subscriptions & Financial Engine
/// ---------------------------------------------------------
model FeeTier {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  baseAmount  Decimal  @db.Decimal(10, 2)
  criteria    Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  studentFees   StudentFee[]
  subscriptions StudentSubscription[]

  @@map("fee_tiers")
}

model StudentFee {
  id               String    @id @default(uuid())
  /// Logical academic-service StudentProfile id (no physical FK across bounded contexts).
  studentProfileId String
  feeTierId        String?
  customAmount     Decimal?  @db.Decimal(10, 2)
  ipcApplied       Boolean   @default(false)
  effectiveFrom    DateTime  @default(now())
  effectiveTo      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  feeTier FeeTier? @relation(fields: [feeTierId], references: [id])

  @@index([studentProfileId])
  @@map("student_fees")
}

model Discount {
  id          String           @id @default(uuid())
  code        String           @unique
  name        String
  description String?
  type        DiscountType
  category    DiscountCategory
  value       Decimal?         @db.Decimal(10, 2)
  startDate   DateTime?
  endDate     DateTime?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  studentDiscounts StudentDiscount[]

  @@map("discounts")
}

model StudentDiscount {
  id               String    @id @default(uuid())
  /// Logical academic-service StudentProfile id (no physical FK across bounded contexts).
  studentProfileId String
  discountId       String
  assignedAt       DateTime  @default(now())
  expiresAt        DateTime?

  discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)

  @@unique([studentProfileId, discountId])
  @@index([studentProfileId])
  @@map("student_discounts")
}

model StudentSubscription {
  id               String  @id @default(uuid())
  /// Logical academic-service StudentProfile id (no physical FK across bounded contexts).
  studentProfileId String
  feeTierId        String
  isActive         Boolean @default(true)

  feeTier FeeTier @relation(fields: [feeTierId], references: [id])

  @@index([studentProfileId])
  @@map("student_subscriptions")
}

/// ---------------------------------------------------------
/// Daily Cash Register Submodule
/// ---------------------------------------------------------
model CashRegisterSession {
  id                     String            @id @default(uuid())
  openedById             String
  closedById             String?
  openingDate            DateTime          @default(now())
  closingDate            DateTime?
  initialBalance         Decimal           @db.Decimal(10, 2)
  expectedClosingBalance Decimal?          @db.Decimal(10, 2)
  actualClosingBalance   Decimal?          @db.Decimal(10, 2)
  discrepancy            Decimal?          @db.Decimal(10, 2)
  status                 CashSessionStatus @default(OPEN)
  notes                  String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  transactions CashTransaction[]

  @@map("cash_register_sessions")
}

model CashTransaction {
  id               String           @id @default(uuid())
  sessionId        String
  studentProfileId String?
  type             CashMovementType
  category         CashCategory
  paymentMethod    PaymentMethod
  amount           Decimal          @db.Decimal(10, 2)
  description      String
  recordedById     String
  createdAt        DateTime         @default(now())

  session CashRegisterSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([studentProfileId])
  @@map("cash_transactions")
}

/// ---------------------------------------------------------
/// Tenant Financial Configuration (SEPA creditor / invoicing)
/// Owned exclusively by financial-service. `tenantId` is the logical academy
/// key from `x-school-id` (no physical Tenant table / cross-service FK).
/// Empty-string defaults let GET create a blank row until staff complete it.
/// ---------------------------------------------------------
model TenantFinancialConfig {
  id         String   @id @default(uuid())
  tenantId   String   @unique
  legalName  String   @default("")
  taxId      String   @default("")
  address    String   @default("")
  city       String   @default("")
  postalCode String   @default("")
  country    String   @default("ES")
  /// SEPA Creditor Identifier (e.g. ES12ZZZ1234567) used in pain.008.
  creditorId String   @default("")
  iban       String   @default("")
  bic        String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("tenant_financial_configs")
}

/// ---------------------------------------------------------
/// Bank Remittance Submodule (SEPA / Caixabank Integration)
/// ---------------------------------------------------------
model BankMandate {
  id                String    @id @default(uuid())
  /// Logical auth-service user id of the payer who owns the IBAN (parent or adult student). Not a User FK.
  payerUserId       String
  iban              String
  bic               String?
  mandateReference  String    @unique
  signatureDate     DateTime
  /// Legal name of the bank-account holder (SEPA debtor).
  accountHolderName String
  /// National ID (DNI/NIF/NIE) of the account holder. Required by Spanish banks (e.g. CaixaBank) on SEPA Direct Debit.
  accountHolderDni  String
  /// Academy key from `x-school-id`. Logical tenant isolation (no Tenant table FK).
  tenantId          String    @default("")
  /// Clickwrap acceptance. `signatureDate` is the SEPA mandate date; `signedAt` is the audit timestamp.
  isSigned          Boolean   @default(false)
  signedAt          DateTime?
  /// Logical auth-service user id of the person who ticked accept (no User @relation).
  signedByUserId    String?
  signatureIp       String?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  remittanceItems RemittanceItem[]

  @@index([tenantId, payerUserId])
  @@map("bank_mandates")
}

model RemittanceBatch {
  id             String           @id @default(uuid())
  batchReference String           @unique
  executionDate  DateTime
  totalAmount    Decimal          @db.Decimal(10, 2)
  totalItems     Int
  status         RemittanceStatus @default(DRAFT)
  generatedById  String
  filePath       String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  items RemittanceItem[]

  @@map("remittance_batches")
}

model RemittanceItem {
  id           String               @id @default(uuid())
  batchId      String
  mandateId    String
  amount       Decimal              @db.Decimal(10, 2)
  status       RemittanceItemStatus @default(PENDING)
  returnReason String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  batch   RemittanceBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  mandate BankMandate     @relation(fields: [mandateId], references: [id])

  @@map("remittance_items")
}

/// ---------------------------------------------------------
/// Federations (financial-service) & Affiliation Licenses (academic-service)
/// `federationId` on licenses/charges is a logical id — no cross-service FK.
/// `holderUserId` is a logical auth-service identity (no User @relation).
/// ---------------------------------------------------------
model Federation {
  id        String    @id @default(uuid())
  /// Academy key from `x-school-id`. Catalogs are tenant-scoped (no global sharing).
  tenantId  String
  name      String
  acronym   String    @default("")
  /// ISO 3166-1 alpha-2 (e.g. "ES").
  country   String    @default("ES")
  /// Official federation contact email (mandatory).
  email     String
  isActive  Boolean   @default(true)
  /// Soft-delete timestamp. Live uniqueness of `(tenantId, name)` is a partial SQL index (`deletedAt IS NULL`).
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  charges  FederationSeasonCharge[]
  contacts FederationContact[]
  seasons  FederationSeason[]

  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@index([tenantId, name])
  @@map("federations")
}

/// Tagged multi-value contact for a federation (several phones/emails/addresses).
model FederationContact {
  id           String                  @id @default(uuid())
  federationId String
  medium       FederationContactMedium
  value        String
  /// Staff label, e.g. "Sede nacional", "Presidencia", "Secretaria".
  tag          String                  @default("")
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  federation Federation @relation(fields: [federationId], references: [id], onDelete: Cascade)

  @@index([federationId, medium])
  @@map("federation_contacts")
}

/// One pricing season for a federation (identity stays on `Federation`).
model FederationSeason {
  id           String   @id @default(uuid())
  federationId String
  /// Display label, e.g. "2026" or "26/27".
  seasonName   String
  /// ISO 4217, e.g. "EUR".
  currency     String   @default("EUR")
  clubCost     Decimal  @default(0) @db.Decimal(10, 2)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  federation   Federation              @relation(fields: [federationId], references: [id], onDelete: Cascade)
  licenseTypes FederationLicenseType[]

  @@unique([federationId, seasonName])
  @@index([federationId])
  @@map("federation_seasons")
}

/// One license product offered in a federation season (insurance variant, etc.).
model FederationLicenseType {
  id        String   @id @default(uuid())
  seasonId  String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  season    FederationSeason            @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  priceRows FederationLicensePriceRow[]

  @@unique([seasonId, name])
  @@index([seasonId])
  @@map("federation_license_types")
}

/// One pricing-matrix row (instructor, adult, or custom birth-year band).
model FederationLicensePriceRow {
  id            String              @id @default(uuid())
  licenseTypeId String
  kind          LicensePriceRowKind
  /// Editable label for CUSTOM rows (e.g. "Infantil/Juvenil").
  label         String              @default("")
  /// Inclusive birth year: members born in this year or later use this row.
  birthYearFrom Int?
  cost          Decimal             @default(0) @db.Decimal(10, 2)
  reduction     Decimal             @default(0) @db.Decimal(10, 2)
  /// Face value charged to the member (`precio cobro`).
  chargePrice   Decimal             @default(0) @db.Decimal(10, 2)
  sortOrder     Int                 @default(0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  licenseType FederationLicenseType @relation(fields: [licenseTypeId], references: [id], onDelete: Cascade)

  @@index([licenseTypeId, kind])
  @@map("federation_license_price_rows")
}

/// Seasonal charge row owned by financial-service (budget + future remittance source).
model FederationSeasonCharge {
  id               String            @id @default(uuid())
  tenantId         String
  federationId     String
  season           String
  holderType       LicenseHolderType
  /// Logical auth-service user id. Null only for `CLUB` rows.
  holderUserId     String?
  /// Logical academic student profile id. Null for staff and club rows.
  studentProfileId String?
  /// Logical academic license id (issued in academic-service).
  licenseId        String?
  /// What the academy owes the federation for this holder.
  costAmount       Decimal           @db.Decimal(10, 2)
  /// What the academy charges the member (0 for club).
  saleAmount       Decimal           @db.Decimal(10, 2)
  isPaid           Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  federation Federation @relation(fields: [federationId], references: [id], onDelete: Cascade)

  @@unique([tenantId, federationId, season, holderType, holderUserId])
  @@index([tenantId, federationId, season])
  @@map("federation_season_charges")
}

/// Affiliation license history owned by academic-service.
model AffiliationLicense {
  id               String                   @id @default(uuid())
  tenantId         String
  /// Logical academic StudentProfile id. Required for STUDENT holders, including minors (no User).
  studentProfileId String?
  /// Logical auth-service identity. Null for minors who have no User.
  holderUserId     String?
  holderType       LicenseHolderType
  /// Logical financial-service federation id (no Federation @relation).
  federationId     String
  /// Logical financial-service `FederationLicenseType` id (no cross-context @relation).
  licenseTypeId    String?
  licenseNumber    String
  /// Season label, e.g. "2026-2027".
  season           String
  validUntil       DateTime
  isActive         Boolean                  @default(true)
  isPaid           Boolean                  @default(false)
  amountCharged    Decimal                  @default(0) @db.Decimal(10, 2)
  status           AffiliationLicenseStatus @default(PENDING)
  /// Logical auth-service identity that funds this license (adult student or parent payer).
  payerUserId      String?
  /// Staff, instructors, or designated profiles issued at zero sale amount.
  isExempt         Boolean                  @default(false)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  /// Staff uniqueness (nullable holderUserId allows multiple minor rows).
  @@unique([tenantId, federationId, holderUserId, season])
  /// Student uniqueness, including minors without a User.
  @@unique([tenantId, federationId, studentProfileId, season])
  @@index([tenantId, validUntil, isActive])
  @@index([tenantId, federationId, season])
  @@index([studentProfileId])
  @@index([payerUserId])
  @@index([licenseTypeId])
  @@map("student_licenses")
}

/// ---------------------------------------------------------
/// Equipment & Inventory (Future Service)
/// ---------------------------------------------------------
/// Merchandising, stock, Gi loans, and POS sales belong to a dedicated inventory
/// bounded context — not academic-service and not extra JSON on `StudentProfile`.
/// When that microservice is introduced, persist gear/loan/sale records there and
/// resolve `studentProfileId` / `userId` over internal HTTP (no cross-service FKs).
/// Do not add inventory tables to this schema until that service owns them.
