// ---------------------------------------------------------
// Prisma Client Generator & Datasource
// ---------------------------------------------------------
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------
// Enums
// ---------------------------------------------------------
enum Role {
  SUPER_ADMIN
  ADMIN_STAFF
  INSTRUCTOR
  STUDENT
  PARENT
}

enum StudentStatus {
  TRIAL
  ACTIVE
  PAUSED
  INACTIVE
}

enum PaymentMethod {
  SEPA
  CASH
  CARD
}

// ---------------------------------------------------------
// Core Models (Users & Lifecycle)
// ---------------------------------------------------------
model User {
  id            String   @id @default(uuid())
  email         String?  @unique
  passwordHash  String?
  firstName     String
  lastName      String
  role          Role     @default(STUDENT)
  
  studentProfile StudentProfile?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("users")
}

model StudentProfile {
  id              String        @id @default(uuid())
  userId          String        @unique
  dni             String?       @unique
  birthDate       DateTime?
  status          StudentStatus @default(TRIAL)
  phone           String?
  
  hasBorrowedGi   Boolean       @default(false)
  
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  guardians       StudentGuardian[]
  statusHistory   StatusHistory[]
  subscriptions   StudentSubscription[]
  licenses        StudentLicense[]
  ranks           StudentRank[]
  attendances     Attendance[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("student_profiles")
}

model Guardian {
  id          String   @id @default(uuid())
  dni         String   @unique
  firstName   String
  lastName    String
  phone       String
  email       String?
  
  students    StudentGuardian[]

  @@map("guardians")
}

model StudentGuardian {
  studentId   String
  guardianId  String
  relation    String?

  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian    Guardian       @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@id([studentId, guardianId])
  @@map("student_guardians")
}

model StatusHistory {
  id               String        @id @default(uuid())
  studentProfileId String
  status           StudentStatus
  reason           String?
  changedAt        DateTime      @default(now())

  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@map("status_history")
}

// ---------------------------------------------------------
// Billing & Quotas (SEPA)
// ---------------------------------------------------------
model FeePlan {
  id            String   @id @default(uuid())
  name          String
  basePrice     Decimal  @db.Decimal(10, 2)
  isActive      Boolean  @default(true)
  
  subscriptions StudentSubscription[]

  @@map("fee_plans")
}

model StudentSubscription {
  id                   String        @id @default(uuid())
  studentProfileId     String
  feePlanId            String
  
  agreedPrice          Decimal       @db.Decimal(10, 2) 
  paymentMethod        PaymentMethod @default(SEPA)
  
  iban                 String?
  accountHolderName    String?
  mandateReference     String?       @unique
  mandateSignatureDate DateTime?
  
  isActive             Boolean       @default(true)

  studentProfile       StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  feePlan              FeePlan        @relation(fields: [feePlanId], references: [id], onDelete: Restrict)

  @@map("student_subscriptions")
}

// ---------------------------------------------------------
// Licenses & Federations
// ---------------------------------------------------------
model Federation {
  id          String   @id @default(uuid())
  name        String   @unique
  
  licenses    StudentLicense[]

  @@map("federations")
}

model StudentLicense {
  id               String   @id @default(uuid())
  studentProfileId String
  federationId     String
  academicYear     String
  licenseNumber    String?
  isActive         Boolean  @default(true)

  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  federation       Federation     @relation(fields: [federationId], references: [id], onDelete: Restrict)

  @@unique([studentProfileId, federationId, academicYear])
  @@map("student_licenses")
}

// ---------------------------------------------------------
// Academic / Progression Models
// ---------------------------------------------------------
model Discipline {
  id          String     @id @default(uuid())
  name        String     @unique
  belts       BeltRank[]

  @@map("disciplines")
}

model BeltRank {
  id                String   @id @default(uuid())
  disciplineId      String
  name              String
  order             Int
  maxStripes        Int      @default(4)
  
  discipline        Discipline @relation(fields: [disciplineId], references: [id], onDelete: Cascade)
  studentRanks      StudentRank[]

  @@map("belt_ranks")
}

model StudentRank {
  id                 String   @id @default(uuid())
  studentProfileId   String
  beltRankId         String
  currentStripes     Int      @default(0)
  accumulatedHours   Int      @default(0)
  
  promotedAt         DateTime @default(now())
  lastStripeAt       DateTime?

  studentProfile     StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  beltRank           BeltRank       @relation(fields: [beltRankId], references: [id], onDelete: Restrict)

  @@unique([studentProfileId, beltRankId])
  @@map("student_ranks")
}

model Attendance {
  id                 String   @id @default(uuid())
  studentProfileId   String
  attendedAt         DateTime @default(now())
  
  countedForRank     Boolean  @default(false) 

  studentProfile     StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@map("attendances")
}
