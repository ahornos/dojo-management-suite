/// ---------------------------------------------------------
/// Prisma Client Generator & Datasource
/// ---------------------------------------------------------
generator client {
  provider      = "prisma-client-js"
  output        = "../client"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// ---------------------------------------------------------
/// Enums
/// ---------------------------------------------------------

enum Role {
  SUPER_ADMIN
  ADMIN_STAFF
  SPORTS_TECHNICAL_DIRECTOR
  INSTRUCTOR
  STUDENT
  PARENT
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DiscountType {
  PERCENTAGE
  FIXED_DISCOUNT
  FREE_PERIOD
}

enum DiscountCategory {
  FAMILY
  SECURITY_FORCES
  TEMPORARY
}

enum CashSessionStatus {
  OPEN
  CLOSED
  RECONCILED
}

enum CashMovementType {
  INCOME
  EXPENSE
}

enum CashCategory {
  MEMBERSHIP_PAYMENT
  EXAM_FEE
  MERCHANDISE_SALE
  OTHER_INCOME
  OPERATIONAL_EXPENSE
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
}

enum RemittanceStatus {
  DRAFT
  GENERATED
  SUBMITTED
  SETTLED
  REJECTED
}

enum RemittanceItemStatus {
  PENDING
  SETTLED
  RETURNED
}

/// ---------------------------------------------------------
/// Core Identity & Users
/// ---------------------------------------------------------

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  dni          String?   @unique
  birthDate    DateTime?
  phone        String?
  address      String?   /// Street address, building number, and apartment/door
  city         String?   /// City or municipality
  state        String?   /// State, province, or region
  postalCode   String?   /// Postal or zip code
  country      String?   @default("ES") /// ISO 3166-1 alpha-2 country code
  isActive     Boolean   @default(true) /// Account status flag for access control
  
  /// A user can hold multiple roles simultaneously (e.g., ADMIN_STAFF and STUDENT)
  roles        Role[]    @default([STUDENT])
  
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  studentProfile      StudentProfile?
  guardianProfile     Guardian?

  reviewedUpdates     ProfileUpdateRequest[] @relation("ProfileUpdateReviewer")
  proposedGraduations GraduationRequest[]    @relation("ProposedGraduations")
  approvedGraduations GraduationRequest[]    @relation("ApprovedGraduations")

  @@map("users")
}

model StudentProfile {
  id         String    @id @default(uuid())
  userId     String    @unique
  
  /// Academic metadata
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  guardians          StudentGuardian[]
  ranks              StudentRank[]
  attendances        Attendance[]
  updateRequests     ProfileUpdateRequest[]
  graduationRequests GraduationRequest[]
  subscriptions      StudentSubscription[]
  licenses           StudentLicense[]
  studentFees        StudentFee[]
  studentDiscounts   StudentDiscount[]
  bankMandates       BankMandate[]

  @@map("student_profiles")
}

model Guardian {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  students  StudentGuardian[]

  @@map("guardians")
}

model StudentGuardian {
  studentProfileId String
  guardianId       String
  relationship     String?

  student  StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  guardian Guardian       @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@id([studentProfileId, guardianId])
  @@map("student_guardians")
}

/// ---------------------------------------------------------
/// Academy Configuration (Disciplines & Ranks)
/// ---------------------------------------------------------

model Discipline {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?

  programs    DisciplineProgram[]

  @@map("disciplines")
}

model DisciplineProgram {
  id           String   @id @default(uuid())
  disciplineId String
  name         String
  minAge       Int      @default(0)
  maxAge       Int      @default(99)

  discipline   Discipline @relation(fields: [disciplineId], references: [id], onDelete: Cascade)
  beltRanks    BeltRank[]

  @@map("discipline_programs")
}

model BeltRank {
  id                  String   @id @default(uuid())
  disciplineProgramId String
  name                String
  order               Int
  maxStripes          Int      @default(4)
  minMonthsRequired   Int      @default(0)
  minHoursRequired    Int      @default(0)

  program             DisciplineProgram @relation(fields: [disciplineProgramId], references: [id], onDelete: Cascade)
  studentRanks        StudentRank[]

  @@map("belt_ranks")
}

/// ---------------------------------------------------------
/// Academic Records (Ranks & Attendances)
/// ---------------------------------------------------------

model StudentRank {
  id               String   @id @default(uuid())
  studentProfileId String
  beltRankId       String
  currentStripes   Int      @default(0)
  accumulatedHours Int      @default(0)
  promotedAt       DateTime @default(now())
  lastStripeAt     DateTime @default(now())

  student          StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  beltRank         BeltRank       @relation(fields: [beltRankId], references: [id])

  @@map("student_ranks")
}

model Attendance {
  id               String   @id @default(uuid())
  studentProfileId String
  date             DateTime @default(now())
  countedForRank   Boolean  @default(true)

  student          StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@map("attendances")
}

/// ---------------------------------------------------------
/// Approval Workflows (IAM & Validation)
/// ---------------------------------------------------------

model ProfileUpdateRequest {
  id               String        @id @default(uuid())
  studentProfileId String
  requestedChanges Json
  status           RequestStatus @default(PENDING)
  reviewedById     String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  reviewer         User?          @relation("ProfileUpdateReviewer", fields: [reviewedById], references: [id])

  @@map("profile_update_requests")
}

model GraduationRequest {
  id               String        @id @default(uuid())
  studentProfileId String
  proposedBeltId   String?
  proposedStripes  Int?
  proposedById     String
  approvedById     String?
  status           RequestStatus @default(PENDING)
  createdAt        DateTime      @default(now())

  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  proposedBy       User           @relation("ProposedGraduations", fields: [proposedById], references: [id])
  approvedBy       User?          @relation("ApprovedGraduations", fields: [approvedById], references: [id])

  @@map("graduation_requests")
}

/// ---------------------------------------------------------
/// Billing, Subscriptions & Financial Engine
/// ---------------------------------------------------------

model FeeTier {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  baseAmount  Decimal  @db.Decimal(10, 2)
  criteria    Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  studentFees   StudentFee[]
  subscriptions StudentSubscription[]

  @@map("fee_tiers")
}

model StudentFee {
  id               String    @id @default(uuid())
  studentProfileId String
  feeTierId        String?
  customAmount     Decimal?  @db.Decimal(10, 2)
  ipcApplied       Boolean   @default(false)
  effectiveFrom    DateTime  @default(now())
  effectiveTo      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  student          StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  feeTier          FeeTier?       @relation(fields: [feeTierId], references: [id])

  @@index([studentProfileId])
  @@map("student_fees")
}

model Discount {
  id          String            @id @default(uuid())
  code        String            @unique
  name        String
  description String?
  type        DiscountType
  category    DiscountCategory
  value       Decimal?          @db.Decimal(10, 2)
  startDate   DateTime?
  endDate     DateTime?
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  studentDiscounts StudentDiscount[]

  @@map("discounts")
}

model StudentDiscount {
  id               String    @id @default(uuid())
  studentProfileId String
  discountId       String
  assignedAt       DateTime  @default(now())
  expiresAt        DateTime?

  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  discount         Discount       @relation(fields: [discountId], references: [id], onDelete: Cascade)

  @@unique([studentProfileId, discountId])
  @@map("student_discounts")
}

model StudentSubscription {
  id               String   @id @default(uuid())
  studentProfileId String
  feeTierId        String
  isActive         Boolean  @default(true)

  student          StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  feeTier          FeeTier        @relation(fields: [feeTierId], references: [id])

  @@map("student_subscriptions")
}

/// ---------------------------------------------------------
/// Daily Cash Register Submodule
/// ---------------------------------------------------------

model CashRegisterSession {
  id                     String            @id @default(uuid())
  openedById             String
  closedById             String?
  openingDate            DateTime          @default(now())
  closingDate            DateTime?
  initialBalance         Decimal           @db.Decimal(10, 2)
  expectedClosingBalance Decimal?          @db.Decimal(10, 2)
  actualClosingBalance   Decimal?          @db.Decimal(10, 2)
  discrepancy            Decimal?          @db.Decimal(10, 2)
  status                 CashSessionStatus @default(OPEN)
  notes                  String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  transactions           CashTransaction[]

  @@map("cash_register_sessions")
}

model CashTransaction {
  id               String            @id @default(uuid())
  sessionId        String
  studentProfileId String?
  type             CashMovementType
  category         CashCategory
  paymentMethod    PaymentMethod
  amount           Decimal           @db.Decimal(10, 2)
  description      String
  recordedById     String
  createdAt        DateTime          @default(now())

  session          CashRegisterSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([studentProfileId])
  @@map("cash_transactions")
}

/// ---------------------------------------------------------
/// Bank Remittance Submodule (SEPA / Caixabank Integration)
/// ---------------------------------------------------------

model BankMandate {
  id               String   @id @default(uuid())
  studentProfileId String
  iban             String
  bic              String?
  mandateReference String   @unique
  signatureDate    DateTime
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  student          StudentProfile   @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  remittanceItems  RemittanceItem[]

  @@map("bank_mandates")
}

model RemittanceBatch {
  id              String           @id @default(uuid())
  batchReference  String           @unique
  executionDate   DateTime
  totalAmount     Decimal          @db.Decimal(10, 2)
  totalItems      Int
  status          RemittanceStatus @default(DRAFT)
  generatedById   String
  filePath        String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  items           RemittanceItem[]

  @@map("remittance_batches")
}

model RemittanceItem {
  id              String               @id @default(uuid())
  batchId         String
  mandateId       String
  amount          Decimal              @db.Decimal(10, 2)
  status          RemittanceItemStatus @default(PENDING)
  returnReason    String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  batch           RemittanceBatch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  mandate         BankMandate          @relation(fields: [mandateId], references: [id])

  @@map("remittance_items")
}

/// ---------------------------------------------------------
/// Federations & Licenses (Foundation)
/// ---------------------------------------------------------

model Federation {
  id       String @id @default(uuid())
  name     String
  country  String

  licenses StudentLicense[]

  @@map("federations")
}

model StudentLicense {
  id               String   @id @default(uuid())
  studentProfileId String
  federationId     String
  licenseNumber    String
  validUntil       DateTime
  isActive         Boolean  @default(true)

  student          StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  federation       Federation     @relation(fields: [federationId], references: [id])

  @@map("student_licenses")
}