# auth-service — required at bootstrap (see src/config/env.validation.ts)
# In Docker these come from the root `.env` via compose `env_file`.
JWT_SECRET=replace-with-a-long-random-secret
INTERNAL_API_KEY=replace-with-a-long-random-internal-key
JWT_EXPIRES_IN=1d
DATABASE_URL=postgresql://dojo_admin:dojo_password@postgres:5432/dojo_management_suite?schema=public
AUTH_SERVICE_PORT=3000
