FROM node:20-alpine

ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0

WORKDIR /app

# Instalar dependencias del sistema necesarias para Prisma en Alpine
RUN apk add --no-cache openssl libc6-compat

# Habilitar pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

# Copiar archivos de configuración del workspace y dependencias raíz
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./

# Copiar los paquetes compartidos y apps
COPY packages/ ./packages/
COPY apps/ ./apps/

# ¡CRÍTICO! Instalar dependencias para poblar /app/node_modules en la imagen
RUN pnpm install

# Establecer el directorio de trabajo en el microservicio correspondiente
WORKDIR /app/apps/auth-service

EXPOSE 3000

CMD ["pnpm", "run", "start:dev"]