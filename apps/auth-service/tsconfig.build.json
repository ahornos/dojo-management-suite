{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "baseUrl": "./",
    "tsBuildInfoFile": "./dist/tsconfig.build.tsbuildinfo",
    "paths": {
      "@dms/shared-auth": ["../../packages/shared-auth/dist/index"],
      "@dms/shared-types": ["../../packages/shared-types/dist/index"],
      "@dms/database": ["../../packages/database/client/index"],
      "@dms/database/*": ["../../packages/database/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts", "*.ts"]
}
