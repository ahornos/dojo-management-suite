FROM node:20-alpine

WORKDIR /app

# Instalar dependencias del sistema necesarias para Prisma en Alpine
RUN apk add --no-cache openssl libc6-compat

# Habilitar pnpm
RUN corepack enable pnpm

# Copiar archivos de configuración del workspace y dependencias raíz
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./

# Copiar los paquetes compartidos y apps
COPY packages/ ./packages/
COPY apps/ ./apps/

# Establecer el directorio de trabajo en el microservicio correspondiente (ej. financial-service)
WORKDIR /app/apps/financial-service

EXPOSE 3000

CMD ["pnpm", "run", "start:dev"]

