{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.ts$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@dms/database(.*)$": "<rootDir>/../../../packages/database$1",
    "^@nestjs/jwt$": "<rootDir>/__mocks__/jwt.mock.ts",
    "^@nestjs/swagger$": "<rootDir>/__mocks__/swagger.mock.ts",
    "^@nestjs/passport$": "<rootDir>/__mocks__/passport.mock.ts"
  }
}