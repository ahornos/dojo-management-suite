FROM node:20-alpine

WORKDIR /app

# Instalar dependencias del sistema necesarias para Prisma en Alpine
RUN apk add --no-cache openssl libc6-compat

# Habilitar pnpm
RUN corepack enable pnpm

# Copiar archivos de configuración del workspace
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./

# Copiar paquetes compartidos
COPY packages/ ./packages/

# Copiar package.json del microservicio
COPY apps/academic-service/package.json ./apps/academic-service/

# Instalar dependencias
RUN pnpm install --no-frozen-lockfile

# Copiar código fuente
COPY apps/academic-service/ ./apps/academic-service/

WORKDIR /app/apps/academic-service

EXPOSE 3000

CMD ["pnpm", "run", "start:dev"]
