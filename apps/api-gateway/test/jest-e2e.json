{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.ts$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@nestjs/axios$": "<rootDir>/__mocks__/axios.mock.ts",
    "^@nestjs/swagger$": "<rootDir>/__mocks__/swagger.mock.ts"
  }
}