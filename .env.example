# =============================================================================
# Dojo Management Suite — root environment template
# Copy to `.env` at the repository root. Docker Compose injects this file into
# every Nest service. Host-side Prisma commands must use DATABASE_URL_HOST.
# =============================================================================

# --- PostgreSQL --------------------------------------------------------------
# In-container hostname (`postgres` on dms-network).
DATABASE_URL=postgresql://dojo_admin:dojo_password@postgres:5432/dojo_management_suite?schema=public
# Host workstation (published port 5433). Used by `pnpm --filter @dms/database db:*`.
DATABASE_URL_HOST=postgresql://dojo_admin:dojo_password@localhost:5433/dojo_management_suite?schema=public

POSTGRES_USER=dojo_admin
POSTGRES_PASSWORD=dojo_password
POSTGRES_DB=dojo_management_suite

# --- JWT (required, no defaults in services) ---------------------------------
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# --- Internal service-to-service auth ----------------------------------------
INTERNAL_API_KEY=replace-with-a-long-random-internal-key

# --- Redis -------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# --- Downstream URLs (gateway + peer HTTP clients) ---------------------------
AUTH_SERVICE_URL=http://auth-service:3000
ACADEMIC_SERVICE_URL=http://academic-service:3000
FINANCIAL_SERVICE_URL=http://financial-service:3000

# --- CORS (comma-separated origins) ------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173

# --- Seed / tenant -----------------------------------------------------------
DEFAULT_SUPER_ADMIN_EMAIL=superadmin@foxjiujitsuacademy.com
DEFAULT_SUPER_ADMIN_PASSWORD=SecurePassword123!
VITE_DEFAULT_TENANT_ID=fox-jiujitsu-academy

# --- Optional SEPA creditor identity (financial-service) ---------------------
DOJO_CREDITOR_IBAN=ES9100000000000000000000
DOJO_CREDITOR_BIC=DEMOESXX
