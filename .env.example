NODE_ENV=development
# ==============================================================================
# DOJO MANAGEMENT SUITE (DMS) - UNIFIED ROOT ENVIRONMENT CONFIGURATION
# ==============================================================================
# This file serves as the Single Source of Truth for local orchestration via 
# Docker Compose. It contains database URLs, security keys, and service endpoints.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# Connection string targeting the internal Docker container network service ('postgres')
DATABASE_URL=postgresql://dojo_admin:dojo_password@postgres:5432/dojo_management_suite?schema=public
DATABASE_URL_HOST=postgresql://dojo_admin:dojo_password@localhost:5433/dojo_management_suite?schema=public
POSTGRES_USER=dojo_admin
POSTGRES_PASSWORD=dojo_password
POSTGRES_DB=dojo_management_suite

# ------------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION (JWT)
# ------------------------------------------------------------------------------
# Cryptographic secret shared across auth-service and academic-service for token validation
JWT_SECRET=super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=1d

# ------------------------------------------------------------------------------
# 3. CACHE & BROKER (Redis)
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 4. MICROSERVICES ROUTING & PORTS
# ------------------------------------------------------------------------------
PORT=3000
AUTH_SERVICE_URL=http://auth-service:3000
ACADEMIC_SERVICE_URL=http://academic-service:3000
FINANCIAL_SERVICE_URL=http://financial-service:3000

# ------------------------------------------------------------------------------
# 5. INITIALIZATION & TENANT SEEDING
# ------------------------------------------------------------------------------
DEFAULT_SUPER_ADMIN_EMAIL=superadmin@foxjiujitsuacademy.com
DEFAULT_SUPER_ADMIN_PASSWORD=SecurePassword123!
IMPORT_PIPELINE_PASSWORD=Dojo2026!
VITE_API_BASE_URL=http://localhost:3000/api
VITE_DEFAULT_TENANT_ID=fox-jiujitsu-academy

# ------------------------------------------------------------------------------
# 6. CORS & SECURITY POLICIES
# ------------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4200
INTERNAL_API_KEY=6fc0a830989010b8eea848b2d96f9119640836df386cbdb5
