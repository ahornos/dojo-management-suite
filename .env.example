# ==============================================
# DOJO MANAGEMENT SUITE - ENVIRONMENT TEMPLATE
# ==============================================

# Database Configuration (PostgreSQL via Docker Compose)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/dojo_management_suite?schema=public"

# Authentication & Security
JWT_SECRET="super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="1d"

# Redis Cache & Session Store
REDIS_HOST="localhost"
REDIS_PORT=6379

# Microservices Ports
ACADEMIC_SERVICE_PORT=3001
AUTH_SERVICE_PORT=3002
FINANCIAL_SERVICE_PORT=3003
API_GATEWAY_PORT=3000